+#!/usr/bin/env python3
+"""
+Unit tests for the LUMPI dashboard server.
+Plays every scenario through handle_telemetry with a fake clock and checks expectations.
+"""
+
+import sys
+import os
+import json
+import time
+import unittest
+from collections import deque
+
+# Add laptop to path
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "laptop"))
+
+from dashboard_server import (
+    check_event,
+    add_event,
+    node_status,
+    get_nodes_json,
+    get_history_json,
+    latest,
+    recent,
+    seen_ids,
+    history,
+    counts,
+    errors,
+    totals,
+    STALE_AFTER_S,
+    OFFLINE_AFTER_S,
+    DARK_LUX,
+    SHOWN_NODES,
+    VALID_NODES,
+    ACTIVITIES,
+    REQUIRED_DATA,
+    EXAMPLES,
+    HINTS,
+    find_hint,
+    get_example_for_error,
+)
+
+
+class FakeClock:
+    """Fake clock for deterministic time control."""
+    def __init__(self, start=1794794400.0):
+        self.now = start
+
+    def time(self):
+        return self.now
+
+    def advance(self, seconds):
+        self.now += seconds
+
+
+class TestDashboardServer(unittest.TestCase):
+    def setUp(self):
+        # Reset all global state
+        global latest, recent, seen_ids, history, counts, errors, totals
+        latest.clear()
+        recent.clear()
+        seen_ids.clear()
+        history.clear()
+        counts.clear()
+        errors.clear()
+        totals["rejected"] = 0
+        totals["error_id"] = 0
+
+        # Use fake clock
+        self.fake_clock = FakeClock()
+        self.original_time = time.time
+        time.time = self.fake_clock.time
+
+    def tearDown(self):
+        time.time = self.original_time
+
+    # DASH-01: no events -> all unknown
+    def test_dash_01_no_events(self):
