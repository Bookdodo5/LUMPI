+/* LUMPI Teacher Dashboard - Style */
+
+:root {
+  --white: #ffffff;
+  --paper: #f7f5f2;
+  --ink:   #1a1a1a;
+  --grey:  #6b6b6b;
+  --line:  #d9d6d1;
+  --red:   #c8102e;
+}
+
+* {
+  box-sizing: border-box;
+}
+
+html, body {
+  margin: 0;
+  padding: 0;
+  font-family: "Noto Sans JP", system-ui, sans-serif;
+  font-size: 16px;
+  line-height: 1.5;
+  font-weight: 400;
+  color: var(--ink);
+  background: var(--paper);
+  -webkit-font-smoothing: antialiased;
+}
+
+h1, h2, h3, h4 {
+  margin: 0;
+  font-weight: 500;
+}
+
+h1 { font-size: 22px; letter-spacing: 0.04em; }
+h2 { font-size: 18px; }
+h3 { font-size: 16px; font-weight: 500; }
+h4 { font-size: 14px; font-weight: 500; color: var(--grey); }
+
+.visually-hidden {
+  position: absolute;
+  width: 1px;
+  height: 1px;
+  padding: 0;
+  margin: -1px;
+  overflow: hidden;
+  clip: rect(0, 0, 0, 0);
+  white-space: nowrap;
+  border: 0;
+}
+
+/* Header */
+header {
+  background: var(--white);
+  border-bottom: 1px solid var(--line);
+  padding: 32px 40px 24px;
+  display: flex;
+  justify-content: space-between;
+  align-items: baseline;
+}
+
+header h1 {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+
+header .mark {
+  width: 12px;
+  height: 12px;
+  border-radius: 50%;
+  background: var(--red);
+  flex-shrink: 0;
+}
+
+#connection {
+  font-size: 14px;
+  color: var(--grey);
+  margin: 0;
+  transition: color 0.2s, font-weight 0.2s;
