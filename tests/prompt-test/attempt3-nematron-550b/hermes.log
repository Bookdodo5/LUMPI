+/* LUMPI Teacher Dashboard - Japanese Minimal Style */
+/* Colour: 60/30/10 - white/paper backgrounds, ink/grey text, red warnings only */
+
+:root {
+  --white: #ffffff;
+  --paper: #f7f5f2;
+  --ink: #1a1a1a;
+  --grey: #6b6b6b;
+  --line: #d9d6d1;
+  --red: #c8102e;
+}
+
+* {
+  box-sizing: border-box;
+  margin: 0;
+  padding: 0;
+}
+
+html, body {
+  height: 100%;
+  font-family: "Noto Sans JP", system-ui, sans-serif;
+  font-size: 16px;
+  line-height: 1.5;
+  font-weight: 400;
+  color: var(--ink);
+  background: var(--paper);
+  -webkit-font-smoothing: antialiased;
+}
+
+/* Header */
+header {
+  background: var(--white);
+  border-bottom: 1px solid var(--line);
+  padding: 32px 40px 24px;
+}
+
+header h1 {
+  font-size: 22px;
+  font-weight: 500;
+  letter-spacing: 0.04em;
+  display: flex;
+  align-items: center;
+  gap: 12px;
+}
+
+header .mark {
+  width: 12px;
+  height: 12px;
+  border-radius: 50%;
+  background: var(--red);
+  flex-shrink: 0;
+}
+
+.connection {
+  font-size: 14px;
+  color: var(--grey);
+  margin-top: 4px;
+  transition: color 0.2s, font-weight 0.2s;
+}
+
+.connection.disconnected {
+  color: var(--red);
+  font-weight: 500;
+}
+
+/* Main content */
+main {
+  max-width: 1100px;
+  margin: 0 auto;
+  padding: 32px 40px 48px;
+}
+
+/* Cards */
+.card {
+  background: var(--white);
+  border: 1px solid var(--line);
+  padding: 24px 28px;
+  margin-top: 24px;
