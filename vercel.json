{
  "regions": ["sin1"],
  "functions": {
    "api/lumpi.py": { "includeFiles": "api/_plumbing.py", "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/telemetry", "destination": "/api/lumpi?route=telemetry" },
    { "source": "/v1/assess", "destination": "/api/lumpi?route=assess" },
    { "source": "/v1/word_audio", "destination": "/api/lumpi?route=word_audio" },
    { "source": "/v1/page", "destination": "/api/lumpi?route=page" },
    { "source": "/api/dashboard/:name", "destination": "/api/lumpi?route=:name" },
    { "source": "/", "destination": "/dashboard/v7/index.html" },
    { "source": "/:file", "destination": "/dashboard/v7/:file" }
  ]
}
